REACT_APP_ZAP_API_TESTNET=https://test-stats.zilswap.org
REACT_APP_ZAP_API_MAINNET=https://stats.zilswap.org

# Emit the webpack runtime as a file instead of an inline <script> so the
# CSP in public/index.html can keep script-src limited to 'self'.
INLINE_RUNTIME_CHUNK=false

# CSP fragments interpolated into public/index.html.
# Production forbids eval; .env.development relaxes it for CRA dev tooling.
# chrome-extension:/moz-extension: keep wallet extensions (Bearby/MetaMask)
# able to inject their providers under the strict policy.
# (Values are double-quoted because dotenv strips the outer quote pair.)
REACT_APP_CSP_SCRIPT_SRC="'self' chrome-extension: moz-extension:"
REACT_APP_CSP_CONNECT_EXTRA=
